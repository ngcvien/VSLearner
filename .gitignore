# .gitignore for VSLearner
# See https://help.github.com/articles/ignoring-files for more info

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
*.egg-info/
*.egg
pip-wheel-metadata/

# Virtual environments
venv/
ENV/
env/
env.bak/
.venv/
venv.bak/

# Pytest
.pytest_cache/

# Coverage
.coverage
coverage.xml
.coverage.*
htmlcov/

# MyPy
.mypy_cache/

# Pyre
.pyre/

# Pylance / language server caches
.pytype/

# Jupyter Notebook checkpoints
.ipynb_checkpoints

# IPython history
ipython_config.py

# VS Code
.vscode/
*.code-workspace

# JetBrains IDEs
.idea/
*.iml

# Sublime
*.sublime-project
*.sublime-workspace

# OS files
.DS_Store
Thumbs.db

# Logs
logs/
*.log

# Secrets / environment settings
.env
.env.*
secrets.json
*.pem
*.key

# Data and large files
# Ignore raw data and enrollment data directories (already in repo currently).
# Adding these here prevents future accidental commits of large datasets.
data/raw/
data/enroll/

# Models and trained artifacts
# If you want to keep models in the repo, remove these lines. Tracked files won't be
# automatically removed by adding this file — see the cleanup commands below.
models/*.h5
models/*.tflite
models/*.ckpt
models/*.pb

# Node / frontend
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
dist/

# Docker
docker-compose.override.yml
